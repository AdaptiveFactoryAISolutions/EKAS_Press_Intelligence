@@ -62,3 +62,32 @@
 
 def labels_path(dataset_dir: Path) -> Path:
     return metadata_file(dataset_dir, "labels_60s.parquet")
+
+
+def period_label(seconds: float) -> str:
+    """Filesystem-safe exact decimal seconds at the timestamp's ns resolution."""
+    import math
+    from decimal import Decimal
+    if isinstance(seconds, bool) or not math.isfinite(seconds) or seconds <= 0:
+        raise ValueError("resample seconds must be positive and finite")
+    nanos = seconds * 1e9
+    if not math.isfinite(nanos) or nanos > 9223372036854775807 or round(nanos) < 1 or not math.isclose(nanos, round(nanos), rel_tol=0, abs_tol=1e-6):
+        raise ValueError("resample seconds must be representable at nanosecond resolution")
+    return format(Decimal(str(seconds)).normalize(), "f").replace(".", "p")
+
+
+def grid_filename(seconds: float) -> str:
+    """Keep the primary irregular historian separate from every regular grid."""
+    suffix = period_label(seconds)
+    return "historian_grid_10s.parquet" if seconds == 10 else f"historian_{suffix}s.parquet"
+
+
+def extra_grid_files(dataset_dir: Path) -> tuple[str, ...]:
+    """Only the exact grid declared by the private export manifest is optional."""
+    import json
+    if not manifest_path(dataset_dir).exists():
+        return ()
+    manifest = json.loads(manifest_path(dataset_dir).read_text(encoding="utf-8"))
+    seconds = manifest.get("resample_seconds", 60)
+    name = grid_filename(seconds)
+    return () if name == HISTORIAN_GRID else (name,)
