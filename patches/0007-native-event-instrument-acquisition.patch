+"""Native instrument acquisition at irregular physical event timestamps.
+
+All event readings pass through actual instrument faults, independent named
+noise/drift streams and quantization before PLC derived statuses. Historian
+node quality is applied later to the held scan observations as usual.
+"""
+from dataclasses import replace
+import math
+import numpy as np
+from historiansim.measurement.instrument import INSTRUMENT_CLASSES,apply_instrument,drift_direction
+
+def acquire_event_series(event_data,spec,seeds,faults,t_grid):
+    times,raw,initial=event_data
+    times=np.asarray(times,dtype=float);readings=np.asarray(raw,dtype=float).copy()
+    if len(times)!=len(readings) or np.any(np.diff(times)<0) or np.any(times<0) or not np.isfinite(times).all():raise ValueError('invalid event instrument series')
+    cls=INSTRUMENT_CLASSES[spec.instrument]
+    if cls.tau_s or cls.sample_s or cls.spike_per_day or cls.freeze_per_month or spec.transport_lag_s:
+        raise ValueError('event instrument requires explicit zero-lag per-event acquisition; transport belongs to the physical event source')
+    for fault in faults:
+        severity=np.array([fault.severity_at(float(t)) for t in times])
+        readings=readings*(1+severity*fault.magnitude) if fault.mode=='scale' else readings+severity*fault.magnitude
+    rng=seeds.get('instrument/'+spec.name+'/events')
+    width=abs(spec.hi-spec.lo) or 1.
+    if cls.noise_sigma and len(times):
+        white=rng.normal(size=len(times));noise=np.empty(len(times));noise[0]=cls.noise_sigma*width*white[0]
+        for i in range(1,len(times)):
+            a=math.exp(-(times[i]-times[i-1])/cls.noise_tau_s) if cls.noise_tau_s>0 else 0.
+            noise[i]=a*noise[i-1]+cls.noise_sigma*width*math.sqrt(max(0.,1-a*a))*white[i]
+        readings+=noise
+    if cls.drift_per_day:
+        readings+=drift_direction(seeds,spec.name)*cls.drift_per_day*width*times/86400.
+    # Reuse native ADC quantization, after the time-aware noise and drift.
+    quantizer=replace(cls,noise_sigma=0.,drift_per_day=0.)
+    readings=apply_instrument(readings,quantizer,spec.span,1.,rng)
+    readings=np.clip(readings,spec.lo,spec.hi)
+    index=np.searchsorted(times,t_grid,side='right')-1
+    sampled=np.where(index>=0,readings[np.maximum(index,0)],initial) if len(readings) else np.full(len(t_grid),initial)
+    return times,readings,sampled
