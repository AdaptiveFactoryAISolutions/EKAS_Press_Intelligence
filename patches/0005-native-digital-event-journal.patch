+"""Optional digital event acquisition, independent of analogue scan interpolation.
+
+A source must explicitly project safe digital fields and associate each event
+code with an actual status tag. The 1ms PLC clock is quantized independently of
+scan time; native acquisition quality at the event's preceding scan masks bad
+or uncertain payloads. No geometry, inspection result or private ledger is read.
+"""
+from __future__ import annotations
+import numpy as np
+import pandas as pd
+
+def public_status_journal(events, measured, origin):
+    project = getattr(events, "public_status_columns", None)
+    if not callable(project):
+        return None
+    times, codes, counts, status_tags = project()
+    times = np.asarray(times, dtype=float)
+    codes = np.asarray(codes, dtype=np.int8).copy()
+    counts = np.asarray(counts, dtype=float).copy()
+    if not (len(times) == len(codes) == len(counts)) or not np.all(np.isfinite(times)) or np.any(times < 0) or np.any(np.diff(times) < 0):
+        raise ValueError("invalid digital event acquisition columns")
+    quality = np.full(len(times), 2, dtype=np.uint8)
+    scan = np.minimum((times / measured.dt).astype(np.int64), measured.n - 1)
+    for code, tag in status_tags.items():
+        mask = codes == code
+        if tag in measured.quality and tag in measured.values:
+            quality[mask] = measured.quality[tag][scan[mask]]
+            invalid = ~np.isfinite(measured.values[tag][scan[mask]])
+            selected = np.flatnonzero(mask)
+            quality[selected[invalid]] = 2
+    hidden = quality != 0
+    codes[hidden] = -1
+    counts[hidden] = np.nan
+    clock_ns = np.rint(times * 1000).astype(np.int64) * 1000000
+    return pd.DataFrame({"timestamp": pd.Timestamp(origin) + pd.to_timedelta(clock_ns, unit="ns"),
+                         "event_code": codes, "count": counts, "quality": quality})
