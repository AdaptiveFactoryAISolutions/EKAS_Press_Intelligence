+class CycleEventSource(Protocol):
+    """Optional hybrid source owned independently by each native simulation.
+
+    Observations are true physical signals before the native transmitter
+    feedback and measurement paths. Advance integrates the same UnitModel,
+    subdividing at physical event boundaries. Events remain private truth;
+    only native measured status tags enter the optional public artifact.
+    """
+
+    events: Sequence[dict]
+
+    def on_controls(self, controllers: dict) -> None: ...
+
+    def observations(self, t: float, x: np.ndarray, u: dict, d: dict, p: dict) -> dict[str, float]: ...
+
+    def advance(self, t: float, x: np.ndarray, u: dict, d: dict, p: dict, dt_sim: float, n_sub: int) -> np.ndarray: ...
 
 
